# Limen OneBot —— 极简 QQNT OneBot v11 协议端
# 标注「重启生效」的项在进程启动时读取；其余项也在启动时读取，本版本没有热更新。

# 监听地址与端口（重启生效）
HOST=127.0.0.1
PORT=5700

# OneBot HTTP / 正向 WebSocket 凭据（至少 24 字符，重启生效）
ONEBOT_ACCESS_TOKEN=
# 管理员接口凭据（至少 24 字符，不能与 OneBot Token 相同，重启生效）
ADMIN_ACCESS_TOKEN=
# 反向 WebSocket 凭据；init 会生成独立值，留空时回退到 ONEBOT_ACCESS_TOKEN（重启生效）
REVERSE_WS_TOKEN=
# 图片能力 URL 的 HMAC 密钥（64 位十六进制，重启生效）
MEDIA_SECRET=

# 数据目录：SQLite 消息 ID 映射、内核消息缓存与内核账号数据（重启生效）
DATA_DIR=./data

# 官方 QQ 运行时（约 1.2 GB）。首次启动会下载或复制本机 QQ（重启生效）
QQ_RUNTIME_DIR=./runtime/qq
QQ_KERNEL_DIR=./runtime/kernel
QQ_KERNEL_DATA=./data/qq-kernel
# download = 从 QQ 官方下载并校验腾讯签名；local = 复制本机已安装的 QQ
QQ_RUNTIME_SOURCE=download
# 指定要登录的 QQ 号；0 表示由扫码决定
QQ_ACCOUNT=0
# 被踢下线后是否自动快速登录。manual = 停下等重新扫码（默认，避免"登录→被踢"循环）
QQ_KICKED_RECONNECT=manual

# 心跳与接口行为
HEARTBEAT_MS=30000
ONEBOT_MAX_REQUEST_BYTES=16777216
QQ_RPC_TIMEOUT_MS=20000
QQ_STARTUP_TIMEOUT_MS=90000

# 发送节奏：同会话串行，全局与同会话最小间隔（毫秒）
SEND_INTERVAL_MS=1200
SESSION_INTERVAL_MS=2500
SEND_CONCURRENCY=4
MAX_PENDING_SENDS=1000

# 媒体：图片/语音/文件缓存
MEDIA_MAX_BYTES=31457280
MEDIA_TIMEOUT_MS=120000
MEDIA_CACHE_DAYS=7
# 公网图片地址（可选，必须是纯 origin，例如 https://bot.example.com）
MEDIA_BASE_URL=

# 消息 ID 映射与内核消息缓存保留天数；0 表示永久保留
HISTORY_RETENTION_DAYS=0

# 反向 WebSocket（逗号分隔），例如 ws://127.0.0.1:8080/onebot/v11/ws
REVERSE_WS_URLS=
# HTTP webhook（可选）
WEBHOOK_URL=
WEBHOOK_SECRET=

# 扫码登录页；关闭后使用 POST /admin/login/start 获取二维码
QR_PAGE_ENABLED=true
